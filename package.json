{
  "name": "rmd-uniform-lifetime",
  "version": "1.0.0",
  "description": "IRS Required Minimum Distribution (RMD) math — the Uniform Lifetime, Single Life and Joint & Last Survivor tables (26 CFR 1.401(a)(9)-9, 2022+) plus 70½/SECURE/SECURE 2.0 required-beginning-date logic. Zero dependencies.",
  "keywords": [
    "rmd",
    "required-minimum-distribution",
    "ira",
    "401k",
    "retirement",
    "uniform-lifetime-table",
    "single-life-table",
    "joint-life-table",
    "secure-act",
    "irs",
    "pub-590b",
    "finance"
  ],
  "homepage": "https://moshemalka.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moshejs/rmd-uniform-lifetime.git"
  },
  "bugs": "https://github.com/moshejs/rmd-uniform-lifetime/issues",
  "author": "Moshe Malka <hello@moshemalka.com> (https://moshemalka.com)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
